{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "port": 3000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:client"],
      "port": 5173
    },
    {
      "name": "server-3001",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set PORT=3001&& npm run dev:server"],
      "port": 3001
    },
    {
      "name": "client-3001",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_SERVER_URL=http://localhost:3001&& npm run dev:client"],
      "port": 5173
    }
  ]
}
